  },
  "overrides": {
    "expo": "~54.0.35",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "expo-status-bar": "~3.0.9",
    "@react-native-async-storage/async-storage": "2.2.0"
  }
}
